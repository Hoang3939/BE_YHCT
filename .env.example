# App
NODE_ENV=development
APP_NAME=YHCT-BE
API_PORT=8080

# API Gateway
API_GATEWAY_PORT=8080

# Database (SQL Server)
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=abc@XYZ1234
DB_NAME=YHCT_DB

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Message Broker (RabbitMQ/Kafka)
BROKER_URL=amqp://guest:guest@localhost:5672

# Auth
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Internal service URLs
AUTH_SERVICE_URL=http://localhost:8101
USER_SERVICE_URL=http://localhost:8102
CATALOG_SERVICE_URL=http://localhost:8103
CHAT_SERVICE_URL=http://localhost:8104
CONTRIBUTION_SERVICE_URL=http://localhost:8105
ADMIN_SERVICE_URL=http://localhost:8106
ANALYTICS_SERVICE_URL=http://localhost:8107
RAG_SERVICE_URL=http://localhost:8090
